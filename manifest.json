{
  "manifest_version": 3,
  "name": "KNOuX GrabFlow — Page Asset Finder",
  "short_name": "KNOuX GrabFlow",
  "description": "Discover and download directly accessible images, video files and documents from the page you choose. Private, local and lightweight.",
  "version": "0.2.0",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "action": {
    "default_title": "KNOuX GrabFlow",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
